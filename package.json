{
  "name": "zana",
  "private": true,
  "packageManager": "pnpm@9.15.3",
  "engines": {
    "node": ">=20.11.0"
  },
  "scripts": {
    "dev": "pnpm --filter @zana/web dev",
    "dev:web": "pnpm --filter @zana/web dev",
    "dev:api": "pnpm --filter @zana/api dev",
    "db:migrate": "pnpm --filter @zana/api prisma:migrate",
    "db:generate": "pnpm --filter @zana/api prisma:generate",
    "db:seed": "pnpm --filter @zana/api prisma:seed",
    "build": "pnpm -r build",
    "lint": "pnpm -r lint",
    "typecheck": "pnpm -r typecheck",
    "storybook": "pnpm --filter @zana/ui storybook"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.2",
    "@typescript-eslint/eslint-plugin": "^8.22.0",
    "@typescript-eslint/parser": "^8.22.0",
    "eslint": "^9.17.0",
    "prettier": "^3.4.2",
    "typescript": "^5.6.3"
  }
}
